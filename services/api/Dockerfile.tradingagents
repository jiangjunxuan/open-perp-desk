FROM python:3.12-slim

ARG API_PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ARG TRADINGAGENTS_REPOSITORY=https://github.com/TauricResearch/TradingAgents.git
ARG TRADINGAGENTS_REF=be952b8eccb49720509af544c6675233bc1f10d0

WORKDIR /app

COPY services/api/requirements.txt /tmp/openperpdesk-requirements.txt
COPY services/api/tradingagents-constraints.txt /tmp/tradingagents-constraints.txt
RUN pip install --no-cache-dir --index-url "$API_PIP_INDEX_URL" -r /tmp/openperpdesk-requirements.txt \
    && apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && mkdir -p /opt/tradingagents \
    && git -C /opt/tradingagents init \
    && git -C /opt/tradingagents remote add origin "${TRADINGAGENTS_REPOSITORY}" \
    && fetched=0 \
    && for attempt in 1 2 3 4 5; do \
         if git -c protocol.version=2 -C /opt/tradingagents fetch --depth 1 --no-tags origin "${TRADINGAGENTS_REF}"; then \
           fetched=1; \
           break; \
         fi; \
         if [ "$attempt" -lt 5 ]; then sleep "$((attempt * 5))"; fi; \
       done \
    && test "$fetched" = 1 \
    && git -C /opt/tradingagents checkout --detach FETCH_HEAD \
    && pip install --no-cache-dir --index-url "$API_PIP_INDEX_URL" -c /tmp/tradingagents-constraints.txt /opt/tradingagents \
    && apt-get purge -y --auto-remove git \
    && rm -rf /var/lib/apt/lists/* /root/.cache

COPY services/api/app ./app

RUN mkdir -p /data/tradingagents/cache /data/tradingagents/results /data/tradingagents/memory \
    && chown -R nobody:nogroup /data
USER nobody
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "20"]
