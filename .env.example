# Runtime
APP_ENV=development
TRADING_MODE=demo
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
# Optional build-only Python package index. Runtime traffic is unaffected.
API_PIP_INDEX_URL=https://pypi.org/simple
ADMIN_API_TOKEN=
MARKET_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
OKX_REST_BASE_URL=https://www.okx.com
OKX_WS_PUBLIC_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_CANDLES_URL=wss://ws.okx.com:8443/ws/v5/business
# Demo private endpoint; leave blank to let OKX_DEMO choose the endpoint.
OKX_WS_PRIVATE_URL=
# Demo business endpoint for native TP/SL algo-order events.
OKX_WS_BUSINESS_URL=

# State storage
# The current control plane uses SQLite in DATA_DIR. Keep the Docker volume.
DATA_DIR=/data
# Optional override; keep the database inside a persistent API volume.
STATE_DB_PATH=

# OKX credentials. Never commit real values.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true
EXECUTION_ENABLED=false
# Live is a separate safety domain. Leave disabled; unlock is process-local.
LIVE_TRADING_ENABLED=false
LIVE_UNLOCK_PHRASE=
AUTO_TRADING_ENABLED=false
AUTO_TRADING_DRY_RUN=true
AUTO_TRADING_SYMBOLS=BTC-USDT-SWAP
AUTO_TRADING_BAR=15m
AUTO_TRADING_INTERVAL_SECONDS=60
AUTO_TRADING_CANDLE_LIMIT=100
AUTO_TRADING_STRATEGY_ID=structured-technical
AUTO_TRADING_ACCOUNT_EQUITY=1000
ACCOUNT_SYNC_INTERVAL_SECONDS=30

# Optional outbound proxy for market and trading workers only.
# Use socks5h:// so DNS resolution also goes through the proxy.
OKX_PROXY_URL=
# Exact HTTPS hosts allowed for server-side quarterly statement downloads.
OKX_ARCHIVE_DOWNLOAD_HOSTS=static.okx.com

# PushPlus notification token. Keep it server-side only.
PUSHPLUS_BASE_URL=https://www.pushplus.plus/send
PUSHPLUS_TOKEN=
PUSHPLUS_PROXY_URL=

# Optional TradingAgents bridge. The API stays structured-strategy-only unless
# the full upstream dependencies and an LLM provider are installed.
TRADINGAGENTS_ENABLED=false
TRADINGAGENTS_PATH=/opt/tradingagents
# Optional separate venv Python; blank uses the API interpreter.
TRADINGAGENTS_PYTHON=
TRADINGAGENTS_TIMEOUT_SECONDS=300
# Per-request timeout for optional Yahoo/yfinance research data calls.
TRADINGAGENTS_DATA_TIMEOUT_SECONDS=8
TRADINGAGENTS_MAX_OUTPUT_BYTES=4194304
TRADINGAGENTS_MAX_TOKENS=4096
TRADINGAGENTS_LLM_MAX_RETRIES=1
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_MAX_RECUR_LIMIT=80
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_LLM_BACKEND_URL=
# Optional keys for the selected provider. Keep them server-side only.
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
TRADINGAGENTS_CACHE_DIR=/data/tradingagents/cache
TRADINGAGENTS_RESULTS_DIR=/data/tradingagents/results
TRADINGAGENTS_MEMORY_LOG_PATH=/data/tradingagents/memory/trading_memory.md

# Optional TradingView alert bridge. TradingView never receives OKX credentials.
# The secret may be sent as the JSON "secret" field or X-TradingView-Token.
TRADINGVIEW_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_EXECUTION_ENABLED=false
TRADINGVIEW_DRY_RUN=true
TRADINGVIEW_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
TRADINGVIEW_DEFAULT_SIZE=1
TRADINGVIEW_SIGNAL_TTL_SECONDS=300
TRADINGVIEW_MAX_AGE_SECONDS=300
TRADINGVIEW_ACCOUNT_EQUITY=1000
TRADINGVIEW_DAILY_PNL_PCT=0
TRADINGVIEW_CURRENT_NOTIONAL=0

# Risk engine defaults. These only evaluate signals in the current phase.
RISK_MAX_LEVERAGE=3
RISK_MAX_POSITION_PCT=10
RISK_MAX_TOTAL_NOTIONAL_PCT=30
RISK_MIN_CONFIDENCE=0.65
RISK_MAX_DAILY_LOSS_PCT=3
RISK_MAX_STOP_DISTANCE_PCT=5
