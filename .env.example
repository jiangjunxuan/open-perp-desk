# Runtime
APP_ENV=development
TRADING_MODE=demo
WEB_PORT=8080

# Database
POSTGRES_DB=openperpdesk
POSTGRES_USER=openperpdesk
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://openperpdesk:change-this-local-password@postgres:5432/openperpdesk
REDIS_URL=redis://redis:6379/0

# OKX credentials. Never commit real values.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true

# Optional outbound proxy for the trading worker only.
# Use socks5h:// so DNS resolution also goes through the proxy.
OKX_PROXY_URL=

# PushPlus notification token. Keep it server-side only.
PUSHPLUS_TOKEN=

